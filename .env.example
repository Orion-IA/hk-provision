# This site currently has no required runtime secrets.
# Public Vite variables, if added later, must use the VITE_ prefix.
# Never put private keys or credentials in VITE_ variables.

# NITRO_HOST=127.0.0.1
# NITRO_PORT=3000

# Public canonical origin used for canonical URLs, Open Graph, sitemap and robots.
# Inlined at build time; no trailing slash.
# VITE_SITE_URL=https://hkprovision.com
