# Public Vite variables must use the VITE_ prefix.
# Never put private keys or credentials in VITE_ variables.

# NITRO_HOST=127.0.0.1
# NITRO_PORT=3000

# Public canonical origin used for canonical URLs, Open Graph, sitemap and robots.
# Inlined at build time; no trailing slash.
# VITE_SITE_URL=https://www.hk-provision.com

# ─── Contact form email, sent through Resend (domain hk-provision.com verified in Resend) ───
# SMTP_PASS is a Resend API key (sending access), NOT the mailbox password, so mailbox
# password changes never break the form. Copy to .env.local for local dev; the same
# variables are set on Vercel. Never commit the real key.
# MAIL_FROM can be any address @hk-provision.com; MAIL_TO / MAIL_REPLY_TO must be a real mailbox.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxx
MAIL_FROM="HK Provision <no-reply@hk-provision.com>"
MAIL_TO=hakim.karoui@hk-provision.com
MAIL_REPLY_TO=hakim.karoui@hk-provision.com
MAIL_SEND_CONFIRMATION=true
